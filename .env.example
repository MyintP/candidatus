# Google AI (Gemini) API - free tier, no credit card required.
# Get one at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your-gemini-key-here

# Jooble Jobs API
VITE_JOOBLE_API_KEY=your-jooble-key-here

# App config
VITE_APP_VERSION=1.0.0

# Generate feature (tailored resume + cover letter from a pasted JD).
# Reads your real master-resume content and calls Gemini directly from the
# browser. Fine for local `npm run dev` - just keep it unset (or false) in
# the env of any build you ever deploy publicly, since that would ship your
# resume content into the bundle.
VITE_ENABLE_GENERATE=true
