# Anthropic Claude API
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Jooble Jobs API
VITE_JOOBLE_API_KEY=your-jooble-key-here

# App config
VITE_APP_VERSION=1.0.0

# Generate feature (tailored resume + cover letter from a pasted JD).
# Reads your real master-resume content and calls Claude directly from the
# browser. Fine for local `npm run dev` in this private repo - just keep it
# unset (or false) in the env of any build you ever deploy publicly, since
# that would bake a usable API key and your resume content into the bundle.
VITE_ENABLE_GENERATE=true
